{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing over the emulator-free unit suite (see vitest.mutation.config.ts for why the integration suite is excluded). Mutants in emulator-only modules report as 'no coverage', not 'survived'.",
  "packageManager": "npm",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "coverageAnalysis": "perTest",
  "concurrency": 3,
  "timeoutMS": 30000,
  "mutate": [
    "src/**/*.ts",
    "!src/generated/**",
    "!src/types.ts",
    "!src/index.ts"
  ],
  "thresholds": { "high": 90, "low": 70, "break": 0 },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
