{
  "name": "y-cinder",
  "version": "3.0.2603070109",
  "description": "A firebase (firestore) provider for Yjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run version-bump && tsc",
    "test": "./scripts/test.sh",
    "version-bump": "node scripts/bump-version.js",
    "emulators:start": "firebase emulators:start",
    "emulators:stop": "lsof -t -i:5001 -i:5002 -i:8080 -i:9000 -i:9099 -i:9199 -i:9090 | xargs kill -9",
    "debugger": "cd debugger && npm run dev",
    "test:ui": "cd debugger && npx playwright test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vrwarp/y-cinder.git"
  },
  "keywords": [
    "y-fire",
    "yjs",
    "firestore",
    "crdt"
  ],
  "author": "podraven",
  "contributors": [
    "vrwarp"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vrwarp/y-cinder/issues"
  },
  "homepage": "https://github.com/vrwarp/y-cinder#readme",
  "devDependencies": {
    "firebase-tools": "^15.4.0",
    "typescript": "^5.3.3",
    "vitest": "^4.0.17"
  },
  "peerDependencies": {
    "firebase": "^11.0.0",
    "yjs": "^13.6.29"
  }
}
